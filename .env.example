# Base URL of the upstream Flight Clipboard app (server-side only, never exposed to the client).
ERAU_BASE_URL=https://webapps.erau.edu/flight-clipboard

# Campus code passed to getRequestsForFueler (e.g. "DB" for Daytona Beach).
FUELER_CAMPUS=DB

# How often the client polls /api/erau/requests for updates, in milliseconds.
NEXT_PUBLIC_POLL_INTERVAL_MS=10000

# When "true", route handlers return canned sample data instead of calling the upstream
# ERAU endpoints. Useful for local development without campus network/VPN access.
USE_MOCK_DATA=false
