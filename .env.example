# Node environment (e.g., "development" or "production").
NODE_ENV=development

# Base URL of the upstream Flight Clipboard app (server-side only, never exposed to the client).
ERAU_BASE_URL=https://webapps.erau.edu/flight-clipboard

# Campus code passed to getRequestsForFueler (e.g. "DB" for Daytona Beach).
FUELER_CAMPUS=DB

# Path to the SQLite database file the collector writes to and the dashboard reads from.
SQLITE_DB_PATH=./data/fuel.db

# The real ERAU "Fueler" access code. Server-only, used ONLY by the always-on collector
# (src/collector/run.ts) to authenticate with upstream — never sent to the browser. Dashboard
# users authenticate with DASHBOARD_ACCESS_CODE instead, which is unrelated and local-only.
ERAU_FUELER_ACCESS_CODE=

# Placeholder for the ERAU "Fueler" access code in mock mode.
ERAU_FUELER_ACCESS_CODE=

# Shared secret dashboard users type into the access-code modal to use the dashboard. Unrelated
# to ERAU_FUELER_ACCESS_CODE and never forwarded upstream.
DASHBOARD_ACCESS_CODE=

# Random string used to sign the local dashboard login session cookie. Generate one with e.g.
# `openssl rand -hex 32` and keep it secret.
DASHBOARD_SESSION_SECRET=

# How often the collector polls ERAU for live requests, in milliseconds.
COLLECTOR_POLL_INTERVAL_MS=3000

# How often the client polls /api/erau/requests for updates, in milliseconds.
NEXT_PUBLIC_POLL_INTERVAL_MS=3000

# When "true", the collector returns canned sample data instead of calling the upstream ERAU
# endpoints. Useful for local development without campus network/VPN access.
USE_MOCK_DATA=false
